# URI de conexión a MongoDB (obligatoria).
# En producción, reemplazar por la URI de MongoDB Atlas.
MONGODB_URI=mongodb://localhost:27017/muebleriajota

# Puerto HTTP del backend (opcional; por defecto 3000).
PORT=3000

# Entorno de ejecución: development | production.
NODE_ENV=development

# Orígenes permitidos por CORS en producción, separados por coma.
# En desarrollo se usan los orígenes locales configurados en config/cors.js.
# Ejemplo: https://muebleria-jota.vercel.app,https://www.muebleria-jota.com
CORS_ORIGINS=http://localhost:5173

# Secreto para firmar y verificar los JWT (obligatorio).
# Sin valor por defecto: la aplicación no inicia si está vacío.
# Generar uno propio con, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Vigencia del token JWT. Formatos admitidos: 1d, 12h, 30m o segundos (3600).
JWT_EXPIRES_IN=1d

# Rondas de bcrypt para hashear contraseñas (entre 10 y 15).
BCRYPT_SALT_ROUNDS=12

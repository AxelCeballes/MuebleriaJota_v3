# URI de conexión a MongoDB (obligatoria).
# En producción, reemplazar por la URI de MongoDB Atlas.
MONGODB_URI=mongodb://localhost:27017/muebleriajota

# Puerto HTTP del backend (opcional; por defecto 3000).
PORT=3000

# Entorno de ejecución: development | production.
NODE_ENV=development

# Orígenes permitidos por CORS en producción, separados por coma.
# En desarrollo se usan los orígenes locales configurados en config/cors.js.
# Ejemplo: https://muebleria-jota.vercel.app,https://www.muebleria-jota.com
CORS_ORIGINS=http://localhost:5173
